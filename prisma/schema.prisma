// Headroom — Prisma schema
//
// Surviving models from the pre-pivot schema: the agent-run audit chain, kept
// because it is already the right shape for the Ledger. See
// docs/superpowers/specs/2026-08-11-headroom-commitments-design.md §5.
// The life graph (Person, Commitment, Artifact, ...) is modeled below,
// per §5. Every life-graph table is scoped to its owning user with a direct
// userId column — the graph is single-tenant per user, never shared.

generator client {
  provider = "prisma-client"
  output   = "../packages/graph/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id          String @id @default(uuid())
  clerkUserId String @unique @map("clerk_user_id")
  email       String

  // Gathered by the /welcome flow. All nullable: `onboardedAt` is the only one
  // that gates anything — it is what distinguishes "hasn't been through
  // /welcome" from "went through it and skipped the optional questions".
  // `timezone` is an IANA zone read off the browser and shown for correction,
  // never asked cold.
  displayName String?   @map("display_name")
  role        String?
  timezone    String?
  onboardedAt DateTime? @map("onboarded_at")

  selfPersonId String?  @unique @map("self_person_id")
  createdAt    DateTime @default(now()) @map("created_at")

  selfPerson       Person?           @relation("UserSelfPerson", fields: [selfPersonId], references: [id], onDelete: Restrict)
  triggerEvents    TriggerEvent[]
  agentRuns        AgentRun[]
  people           Person[]          @relation("PersonOwner")
  identities       Identity[]
  artifacts        Artifact[]
  commitments      Commitment[]
  commitmentEvents CommitmentEvent[]
  capacitySignals  CapacitySignal[]
  actions          Action[]
  labels           Label[]
  connectorCursors ConnectorCursor[]
  trackedPullRequests TrackedPullRequest[]
  googleHealthToken GoogleHealthToken?
  slackToken        SlackToken?

  @@map("user")
}

// ---------------------------------------------------------------------------
// Orchestration — what woke the agent, and the traced/retryable run
// ---------------------------------------------------------------------------

enum TriggerType {
  schedule
  source_event
  manual_feedback
  threshold
}

model TriggerEvent {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  triggerType     TriggerType @map("trigger_type")
  payload         Json
  interpretedAs   Json?       @map("interpreted_as")
  idempotencyKey  String      @unique @map("idempotency_key")
  providerEventId String?     @map("provider_event_id")
  receivedAt      DateTime    @default(now()) @map("received_at")

  user      User       @relation(fields: [userId], references: [id])
  agentRuns AgentRun[]

  @@index([userId])
  @@map("trigger_event")
}

enum AgentRunStatus {
  running
  ok
  retrying
  error
}

model AgentRun {
  id              String         @id @default(uuid())
  userId          String         @map("user_id")
  triggerEventId  String         @map("trigger_event_id")
  status          AgentRunStatus
  langfuseTraceId String?        @map("langfuse_trace_id")
  tokenCost       Decimal?       @map("token_cost") @db.Decimal(10, 4)
  surfaced        Boolean        @default(false)
  startedAt       DateTime       @default(now()) @map("started_at")
  finishedAt      DateTime?      @map("finished_at")

  user         User              @relation(fields: [userId], references: [id])
  triggerEvent TriggerEvent      @relation(fields: [triggerEventId], references: [id])
  attempts     AgentRunAttempt[]
  checkIns     CheckIn[]
  actions      Action[]

  @@index([userId])
  @@index([triggerEventId])
  @@map("agent_run")
}

model AgentRunAttempt {
  id           String         @id @default(uuid())
  agentRunId   String         @map("agent_run_id")
  attemptNo    Int            @map("attempt_no")
  status       AgentRunStatus
  errorCode    String?        @map("error_code")
  errorMessage String?        @map("error_message")
  startedAt    DateTime       @default(now()) @map("started_at")
  finishedAt   DateTime?      @map("finished_at")

  agentRun AgentRun @relation(fields: [agentRunId], references: [id])

  @@unique([agentRunId, attemptNo])
  @@map("agent_run_attempt")
}

// ---------------------------------------------------------------------------
// The life graph — design doc §5
// ---------------------------------------------------------------------------

enum IdentityKind {
  email
  github
  phone
  spoken_name
  slack
}

enum ArtifactSource {
  github
  gmail
  calendar
  voice_note
  google_health
  slack
}

enum CommitmentDirection {
  owed_by_me
  owed_to_me
}

enum DuePrecision {
  exact
  day
  week
  vague
}

enum CommitmentStatus {
  open
  at_risk
  overdue
  fulfilled
  cancelled
  superseded
  rejected
}

enum CommitmentEventKind {
  created
  restated
  moved
  fulfilled
  cancelled
  superseded
}

enum CapacitySignalKind {
  sleep
  rhr
  hrv
  meeting_hours
  free_hours
}

enum ActionTier {
  tier_1
  tier_2
  tier_3
  tier_4
}

enum ActionStatus {
  proposed
  executed
  approved
  undone
  failed
}

enum LabelVerdict {
  real
  not_real
  already_done
}

enum ConnectorCursorStatus {
  idle
  running
  error
}

enum TrackedPullRequestState {
  open
  merged
  closed
}

model Person {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  displayName  String   @map("display_name")
  primaryEmail String?  @map("primary_email")
  githubLogin  String?  @map("github_login")
  createdAt    DateTime @default(now()) @map("created_at")

  user                      User         @relation("PersonOwner", fields: [userId], references: [id])
  selfOfUser                User?        @relation("UserSelfPerson")
  identities                Identity[]
  authoredArtifacts         Artifact[]
  commitmentsAsCounterparty Commitment[]

  @@index([userId])
  @@map("person")
}

model Identity {
  id         String       @id @default(uuid())
  userId     String       @map("user_id")
  personId   String       @map("person_id")
  kind       IdentityKind
  value      String
  confidence Decimal      @db.Decimal(5, 4)
  createdAt  DateTime     @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id])
  person Person @relation(fields: [personId], references: [id])

  @@unique([userId, kind, value])
  @@index([personId])
  @@map("identity")
}

model Artifact {
  id             String         @id @default(uuid())
  userId         String         @map("user_id")
  source         ArtifactSource
  externalId     String?        @map("external_id")
  occurredAt     DateTime       @map("occurred_at")
  authorPersonId String?        @map("author_person_id")
  excerpt        String
  url            String?
  rawRef         String?        @map("raw_ref")
  createdAt      DateTime       @default(now()) @map("created_at")

  user               User                 @relation(fields: [userId], references: [id])
  authorPerson       Person?              @relation(fields: [authorPersonId], references: [id], onDelete: Restrict)
  sourcedCommitments Commitment[]
  commitmentEvents   CommitmentEvent[]
  capacitySignals    CapacitySignal[]
  trackedPullRequest TrackedPullRequest?

  @@unique([userId, source, externalId])
  @@index([userId])
  @@index([authorPersonId])
  @@map("artifact")
}

// Open/closed state for your own PRs, which an Artifact deliberately cannot
// carry: an artifact is an immutable fact ("this PR existed, here is the
// quote"), so it has no status to go stale. Commitments carry their own
// status and get invalidated each sync — but a PR with no requested reviewer
// has no counterparty and therefore no commitment, which left nowhere to
// record that it is still open. Without this row the UI would list every PR
// you ever opened, forever.
//
// Title and url are NOT duplicated here — they live on the Artifact, which
// stays the single provenance record (§3 rule 2). This model holds only what
// changes over time.
model TrackedPullRequest {
  id         String                  @id @default(uuid())
  userId     String                  @map("user_id")
  artifactId String                  @unique @map("artifact_id")
  number     Int
  state      TrackedPullRequestState @default(open)
  // Stamped every sync that still sees the PR open, so a row that stops being
  // seen is distinguishable from one that was never re-checked.
  lastSeenAt DateTime                @map("last_seen_at")
  closedAt   DateTime?               @map("closed_at")
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id])
  artifact Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([userId, state])
  @@map("tracked_pull_request")
}

model Commitment {
  id                       String              @id @default(uuid())
  userId                   String              @map("user_id")
  direction                CommitmentDirection
  summary                  String
  counterpartyPersonId     String              @map("counterparty_person_id")
  dueAt                    DateTime?           @map("due_at")
  duePrecision             DuePrecision        @map("due_precision")
  status                   CommitmentStatus    @default(open)
  confidence               Decimal             @db.Decimal(5, 4)
  sourceArtifactId         String              @map("source_artifact_id")
  quote                    String
  closedAt                 DateTime?           @map("closed_at")
  closedReason             String?             @map("closed_reason")
  supersededByCommitmentId String?             @map("superseded_by_commitment_id")
  createdAt                DateTime            @default(now()) @map("created_at")

  user                     User                    @relation(fields: [userId], references: [id])
  counterpartyPerson       Person                  @relation(fields: [counterpartyPersonId], references: [id])
  sourceArtifact           Artifact                @relation(fields: [sourceArtifactId], references: [id])
  supersededBy             Commitment?             @relation("CommitmentSupersession", fields: [supersededByCommitmentId], references: [id], onDelete: Restrict)
  superseded               Commitment[]            @relation("CommitmentSupersession")
  events                   CommitmentEvent[]
  actions                  Action[]
  labels                   Label[]
  checkIns                 CheckIn[]
  recommendationOutcomes   RecommendationOutcome[]

  @@unique([userId, sourceArtifactId])
  @@index([userId])
  @@index([counterpartyPersonId])
  @@index([status])
  @@index([dueAt])
  @@map("commitment")
}

model CommitmentEvent {
  id           String              @id @default(uuid())
  userId       String              @map("user_id")
  commitmentId String              @map("commitment_id")
  kind         CommitmentEventKind
  artifactId   String              @map("artifact_id")
  at           DateTime

  user       User       @relation(fields: [userId], references: [id])
  commitment Commitment @relation(fields: [commitmentId], references: [id])
  artifact   Artifact   @relation(fields: [artifactId], references: [id])

  @@index([userId])
  @@index([commitmentId])
  @@index([artifactId])
  @@map("commitment_event")
}

model CapacitySignal {
  id               String             @id @default(uuid())
  userId           String             @map("user_id")
  kind             CapacitySignalKind
  value            Decimal            @db.Decimal(10, 4)
  unit             String
  forDate          DateTime           @map("for_date") @db.Date
  sourceArtifactId String             @map("source_artifact_id")

  user           User     @relation(fields: [userId], references: [id])
  sourceArtifact Artifact @relation(fields: [sourceArtifactId], references: [id])

  @@unique([userId, kind, forDate])
  @@index([sourceArtifactId])
  @@map("capacity_signal")
}

model Action {
  id           String       @id @default(uuid())
  userId       String       @map("user_id")
  tier         ActionTier
  kind         String
  commitmentId String?      @map("commitment_id")
  status       ActionStatus
  payload      Json
  externalRef  String?      @map("external_ref")
  executedAt   DateTime?    @map("executed_at")
  undoneAt     DateTime?    @map("undone_at")
  agentRunId   String       @map("agent_run_id")

  user       User        @relation(fields: [userId], references: [id])
  commitment Commitment? @relation(fields: [commitmentId], references: [id], onDelete: Restrict)
  agentRun   AgentRun    @relation(fields: [agentRunId], references: [id])

  @@index([userId])
  @@index([commitmentId])
  @@index([agentRunId])
  @@index([status])
  @@map("action")
}

model Label {
  id           String       @id @default(uuid())
  userId       String       @map("user_id")
  commitmentId String       @map("commitment_id")
  verdict      LabelVerdict
  labeledAt    DateTime     @map("labeled_at")

  user       User       @relation(fields: [userId], references: [id])
  commitment Commitment @relation(fields: [commitmentId], references: [id])

  @@index([userId])
  @@index([commitmentId])
  @@map("label")
}

model ConnectorCursor {
  id           String                @id @default(uuid())
  userId       String                @map("user_id")
  source       ArtifactSource
  cursor       Json?
  status       ConnectorCursorStatus @default(idle)
  lastSyncedAt DateTime?             @map("last_synced_at")
  errorMessage String?               @map("error_message")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, source])
  @@map("connector_cursor")
}

// Google Health's API rejects any access token carrying a scope outside its
// own family — including the baseline scopes Clerk bundles onto every Google
// connection — so this is the one source whose token can't ride on Clerk's
// per-user social connection. 2026-08-14 spec §9a. Both tokens are stored
// as encryptToken()'s {encrypted, iv, authTag} bundle, not plaintext — this
// is a live OAuth refresh token, not a value to leave sitting readable.
model GoogleHealthToken {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  accessToken  Json     @map("access_token")
  refreshToken Json     @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("google_health_token")
}

// Slack user tokens (xoxp-) don't expire unless token rotation is turned on
// for the app, so unlike Google Health there's no refresh grant and no
// expiresAt — the stored token stays valid until revoked. Still encrypted at
// rest: a user token carries DM read access, which is the most sensitive
// grant any integration here holds. 2026-08-15 spec §2.
//
// teamId backs permalink construction (spec §4) and slackUserId lets ingest
// tell the user's own messages from everyone else's without a users.info call.
model SlackToken {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  accessToken Json     @map("access_token")
  teamId      String   @map("team_id")
  slackUserId String   @map("slack_user_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("slack_token")
}

// ---------------------------------------------------------------------------
// Feedback loop — the one surfaced decision and whether the user acted on it
// ---------------------------------------------------------------------------

enum CheckInChannel {
  ui
  email
}

model CheckIn {
  id                String         @id @default(uuid())
  agentRunId        String         @map("agent_run_id")
  commitmentId      String?        @map("commitment_id")
  decisionText      String         @map("decision_text")
  whatChanged       String?        @map("what_changed")
  materialityReason String?        @map("materiality_reason")
  channel           CheckInChannel
  response          Json?
  respondedAt       DateTime?      @map("responded_at")

  agentRun   AgentRun    @relation(fields: [agentRunId], references: [id])
  commitment Commitment? @relation(fields: [commitmentId], references: [id], onDelete: Restrict)

  @@index([agentRunId])
  @@index([commitmentId])
  @@map("check_in")
}

enum DetectionMethod {
  self_report
  inferred_txn
}

model RecommendationOutcome {
  id                String           @id @default(uuid())
  commitmentId      String           @map("commitment_id")
  recommendedAmount Decimal          @map("recommended_amount") @db.Decimal(14, 2)
  acted             Boolean?
  observedAmount    Decimal?         @map("observed_amount") @db.Decimal(14, 2)
  detectionMethod   DetectionMethod? @map("detection_method")
  confidence        Decimal?         @db.Decimal(5, 4)
  observedAt        DateTime?        @map("observed_at")

  commitment Commitment @relation(fields: [commitmentId], references: [id])

  @@index([commitmentId])
  @@map("recommendation_outcome")
}
